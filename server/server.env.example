# Copy this file to server/.env and fill in real values.
# Never commit the real .env (it's already gitignored).

# --- Required ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# DB_NAME is optional — only set it if your MONGO_URI doesn't already
# point at the right database, or if you want to override it locally
# (e.g. a separate "dmdlab_dev" DB so local testing never touches prod data).
DB_NAME=dmdlab_dev

# --- Server ---
PORT=8500

# --- Admin auth ---
# Defaults (admin / password / deepminds-secret) are fine for a first local
# test, but the server refuses to start with NODE_ENV=production unless
# these are changed:
ADMIN_USER=admin
# Preferred: a bcrypt hash, generated with:
#   node server/scripts/hash-admin-password.js "your-new-password"
ADMIN_PASS_HASH=
# Legacy/local-only fallback — only used if ADMIN_PASS_HASH is unset.
ADMIN_PASS=password
ADMIN_JWT_SECRET=change-me-please
ADMIN_JWT_EXPIRES=8h

# --- Cloudinary (only needed once you test article image upload) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- YouTube (only needed for the /videos endpoints) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# --- CORS (defaults already include localhost:5173, Vercel + Render prod
# URLs — only needed for extra origins, e.g. a Vercel preview URL) ---
CORS_ORIGINS=
