# Copy this file to .env and fill in real values. Never commit .env.

# --- Neon Postgres (required) ---
# Pooled connection from the Neon console for the app.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection — used by drizzle-kit migrations / seed only.
# Same host but WITHOUT the -pooler suffix.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Neon Auth (Managed Better Auth) ---
# Auth URL from the Neon console "Neon Auth" page (format: https://ep-xxxx.neonauth.<region>.aws.neon.tech/neondb/auth).
NEON_AUTH_BASE_URL=
# Signing secret for the session cookie. Min 32 chars. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Admin ---
# Email the admin user is created with (scripts/create-admin.ts).
ADMIN_EMAIL=admin@dmdlab.example

# --- Contact form (Resend) ---
# https://resend.com/keys — CONTACT_FROM must be a verified sender
# (onboarding@resend.dev works as a sandbox placeholder).
RESEND_API_KEY=
CONTACT_EMAIL=hello@dmdlab.example
CONTACT_FROM=onboarding@resend.dev

# --- Cloudinary (only needed once you test article image upload) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- YouTube (only needed for the /api/videos endpoints) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
